/**********************************************/ 
/*                    CPU                     */
/**********************************************/ 

// Xtensa 32-bits LX6 240MHz 
app_cpu: CPU.Xtensa @ sysbus
    cpuType: "esp32"
    cpuId: 0x00

// Xtensa 32-bits LX6 240MHz    
pro_cpu: CPU.Xtensa @ sysbus
    cpuType: "esp32"
    cpuId: 0x01

// gic:
//	<TODO>

/**********************************************/ 
/*                   MEMORY                   */
/**********************************************/ 

/* ================== ROM =================== */

// 384KB Internal ROM0 (0x4000_0000 - 0x4005_FFFF)
rom0_irom: Memory.MappedMemory @ sysbus 0x40000000
    size: 0x60000

// 64KB (0x3FF9_0000 - 0x3FF9_FFFF)
rom1_drom: Memory.MappedMemory @ sysbus 0x3FF90000
    size: 0x10000

/* ================== SRAM ================== */

// 192KB SRAM (0x4007_0000 - 0x4009_FFFF)
sram0_iram: Memory.MappedMemory @ sysbus 0x40070000
    size: 0x30000

// 128KB SRAM (0x3FFE_0000 - 0x3FFF_FFFF) (data bus)
//            (0x400A_0000 - 0x400B_FFFF) (instruction bus)
sram1_dram: Memory.MappedMemory @ sysbus 0x3FFE0000
    size: 0x20000
sram1_iram: Memory.MappedMemory @ sysbus 0x400A0000
    size: 0x20000

// 200KB SRAM (0x3FFA_E000 - 0x3FFD_FFFF)
sram2_dram: Memory.MappedMemory @ sysbus 0x3FFAE000
    size: 0x32000

/* RTC FAST is already mapped inside the IRAM or DRAM. */
// 8KB RTC Fast
// rtc_fast: Memory.MappedMemory @ {
//         sysbus @ 0x400C0000; // IRAM View (executable)
//         sysbus @ 0x3FF80000; // DRAM View (data access)
//     }
//     size: 0x2000

// 8KB RTC Fast (0x5000_0000 - 0x5000_1FFF)
rtc_slow: Memory.MappedMemory @ sysbus 0x50000000
    size: 0x2000

// Specific to WROOM32 model
// - 4MB     SPI Flash (0x3F40_0000 - 0x3F7F_FFFF) (data)
// - 11512KB SPI Flash (0x400C_2000 - 0x40BF_FFFF) (instruction)
dflash: Memory.MappedMemory @ sysbus 0x3F400000
    size: 0x400000
iflash: Memory.MappedMemory @ sysbus 0x400C2000
    size: 0xb3e000

/**********************************************/ 
/*                PERIPHERALS                 */
/**********************************************/ 

// UART0 (0x3FF4_0000 - 0x3FF4_0FFF)
uart0: UART.ESP32_UART @ sysbus <0x3FF40000, +0x1000>

// // I2C (0x3FF5_3000 - 0x3FF5_3FFF)
// i2c0: ? @ sysbus
// 
// // I2C1 (0x3FF6_7000 - 0x3FF6_7FFF)
// // i2c1: 
// 
// wifi:
// 
// gpios:
